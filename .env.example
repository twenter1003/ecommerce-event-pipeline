# docker compose가 읽는다. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 실패 알림을 보낼 Slack 웹훅. 비워 두면 알림이 Airflow 로그 한 줄로 대신 남는다.
# AIRFLOW_CONN_SLACK_ALERT='{"conn_type":"slackwebhook","password":"https://hooks.slack.com/services/T.../B.../..."}'
AIRFLOW_CONN_SLACK_ALERT=

# Airflow 구성 요소끼리 쓰는 토큰 서명 키(필수). 아래 명령으로 만든 값을 넣는다.
#   openssl rand -base64 64 | tr -d '\n'
AIRFLOW__API_AUTH__JWT_SECRET=

# 3단계 lake: SeaweedFS S3 키(필수). 아래 명령으로 만든 값을 넣는다
#   LAKE_S3_ACCESS_KEY: openssl rand -hex 16    LAKE_S3_SECRET_KEY: openssl rand -hex 32
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=
